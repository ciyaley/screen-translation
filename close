#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME_DIR="${ROOT_DIR}/.runtime"

# 1. ScreenTranslate UIプロセスの終了
if [[ -f "${RUNTIME_DIR}/control.cmd" ]]; then
    printf "quit\n" > "${RUNTIME_DIR}/control.cmd" 2>/dev/null || true
fi

if [[ -f "${RUNTIME_DIR}/pid" ]]; then
    TARGET_PID="$(cat "${RUNTIME_DIR}/pid" 2>/dev/null || true)"
    if [[ -n "${TARGET_PID}" ]] && kill -0 "${TARGET_PID}" 2>/dev/null; then
        kill -TERM "${TARGET_PID}" 2>/dev/null || true
    fi
fi

/usr/bin/pkill -x ScreenTranslate 2>/dev/null || true

for _ in {1..20}; do
    if ! /usr/bin/pgrep -x ScreenTranslate >/dev/null 2>&1; then
        break
    fi
    sleep 0.05
done

if /usr/bin/pgrep -x ScreenTranslate >/dev/null 2>&1; then
    /usr/bin/pkill -9 -x ScreenTranslate 2>/dev/null || true
fi
rm -f "${RUNTIME_DIR}/pid"

# 2. PLaMo 3 サイドカー推論サーバーも停止してメモリを完全解放
if [[ -f "${ROOT_DIR}/scripts/manage_plamo.sh" ]]; then
    bash "${ROOT_DIR}/scripts/manage_plamo.sh" stop >/dev/null 2>&1 || true
fi

echo "ScreenTranslate and PLaMo sidecar stopped cleanly."
